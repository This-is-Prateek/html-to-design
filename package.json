{
  "name": "html-to-design",
  "version": "0.1.0",
  "private": true,
  "description": "Figma plugin: convert HTML/CSS into Figma frames, locally.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node build.mjs && playwright test"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "@playwright/test": "^1.50.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.24.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
